# ============================================
# StockPulse Korea - 환경변수 설정
# ============================================
# 이 파일을 .env.local로 복사하여 사용하세요:
#   cp .env.example .env.local

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- 네이버 뉴스 검색 API ---
# 발급: https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# --- 한국투자증권 Open API ---
# 발급: https://apiportal.koreainvestment.com
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
KIS_ACCOUNT_NO=12345678-01
KIS_IS_MOCK=true

# --- OpenAI API (감성분석 + AI 요약) ---
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# --- Cron 보안 (Vercel Cron 시크릿) ---
CRON_SECRET=your-random-secret-string
